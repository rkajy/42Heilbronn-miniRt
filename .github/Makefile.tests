CC := cc
CXX := c++
CPPFLAGS := -Iinclude -Ilib/libft/includes
CFLAGS := -Wall -Wextra -Werror $(CPPFLAGS)
CXXFLAGS := -Wall -Wextra -Werror -std=c++17 $(CPPFLAGS)

NAME := .github/tests_runner
NAME_CMAKE := .github/tests_runner_cmake
OBJ_DIR := build/tests
CMAKE_BUILD_DIR := build/tests_cmake
SRC_DIR := src
TEST_DIR := .github/tests
GTEST_DIR ?= ./lib/googletest
GTEST_HEADER := $(GTEST_DIR)/googletest/include/gtest/gtest.h
GTEST_ROOT := $(GTEST_DIR)/googletest
CMAKE_GTEST_DIR := $(GTEST_DIR)/cmake_build

LIB_DIR := ./lib
LIBFT_DIR := $(LIB_DIR)/libft
LIBFT_NAME := $(LIBFT_DIR)/libft.a
LIBFT_PRINTF_NAME := $(LIBFT_DIR)/libftprintf.a


GREEN := \033[1;32m
RED := \033[1;31m
BLUE := \033[1;34m
RESET := \033[0m

OK := ✔
FAIL := ✖
ARROW := ➜

C_SRC := \
	$(SRC_DIR)/math/math_first.c \
	$(SRC_DIR)/parse/parse_first.c

C_OBJ := $(C_SRC:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)
TEST_SRC := $(TEST_DIR)/test_demo.cpp
TEST_OBJ := $(TEST_SRC:$(TEST_DIR)/%.cpp=$(OBJ_DIR)/%.o)

GTEST_INC := -I$(GTEST_ROOT)/include -I$(GTEST_ROOT)
GTEST_SRC := \
	$(GTEST_ROOT)/src/gtest-all.cc \
	$(GTEST_ROOT)/src/gtest_main.cc
GTEST_OBJ := $(GTEST_SRC:$(GTEST_ROOT)/src/%.cc=$(OBJ_DIR)/gtest/%.o)
GTEST_LIBS := $(GTEST_OBJ)

CMAKE_GTEST_LIBS := \
	$(CMAKE_GTEST_DIR)/lib/libgtest.a \
	$(CMAKE_GTEST_DIR)/lib/libgtest_main.a
CMAKE_C_OBJ := $(C_SRC:$(SRC_DIR)/%.c=$(CMAKE_BUILD_DIR)/%.o)
CMAKE_TEST_OBJ := $(TEST_SRC:$(TEST_DIR)/%.cpp=$(CMAKE_BUILD_DIR)/%.o)

all: test

$(LIBFT_NAME):
	@$(MAKE) -C $(LIBFT_DIR) > /dev/null 2>&1
	@echo "$(GREEN)$(OK) libft built successfully!$(RESET)"

$(LIBFT_PRINTF_NAME):
	@$(MAKE) -C $(LIBFT_DIR) > /dev/null 2>&1
	@echo "$(GREEN)$(OK) libft printf built successfully!$(RESET)"

$(NAME): $(C_OBJ) $(TEST_OBJ) $(GTEST_OBJ) $(LIBFT_NAME) $(LIBFT_PRINTF_NAME)
	$(CXX) $(CXXFLAGS) $(C_OBJ) $(TEST_OBJ) $(GTEST_LIBS) $(LIBFT_NAME) $(LIBFT_PRINTF_NAME) -o $(NAME)

$(NAME_CMAKE): $(CMAKE_C_OBJ) $(CMAKE_TEST_OBJ) $(CMAKE_GTEST_LIBS) $(LIBFT_NAME) $(LIBFT_PRINTF_NAME)
	$(CXX) $(CXXFLAGS) $(CMAKE_C_OBJ) $(CMAKE_TEST_OBJ) $(CMAKE_GTEST_LIBS) $(LIBFT_NAME) $(LIBFT_PRINTF_NAME) \
		-o $(NAME_CMAKE)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: $(TEST_DIR)/%.cpp | $(GTEST_DIR)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(GTEST_ROOT)/include -I$(GTEST_ROOT) -c $< -o $@

$(OBJ_DIR)/gtest/%.o: $(GTEST_ROOT)/src/%.cc | $(GTEST_DIR)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(GTEST_INC) -c $< -o $@

$(CMAKE_BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(CMAKE_BUILD_DIR)/%.o: $(TEST_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(GTEST_INC) -c $< -o $@

$(GTEST_DIR):
	@git clone https://github.com/google/googletest.git $(GTEST_DIR)

check-gtest: $(GTEST_DIR)
	@if [ -f "$(GTEST_HEADER)" ] || [ -f "/usr/include/gtest/gtest.h" ] || \
		[ -f "/usr/local/include/gtest/gtest.h" ]; then \
		exit 0; \
	else \
		printf "GoogleTest introuvable apres le clone.\n"; \
		exit 1; \
	fi

check-cmake:
	@if command -v cmake >/dev/null 2>&1; then \
		exit 0; \
	else \
		printf "cmake introuvable.\n"; \
		exit 1; \
	fi

$(CMAKE_GTEST_LIBS): check-gtest check-cmake
	@cmake -S $(GTEST_DIR) -B $(CMAKE_GTEST_DIR) > /dev/null
	@cmake --build $(CMAKE_GTEST_DIR) > /dev/null

test: check-gtest $(NAME)
	./$(NAME)

test-cmake: check-gtest $(NAME_CMAKE)
	./$(NAME_CMAKE)

clean:
	rm -rf $(OBJ_DIR)
	rm -rf $(GTEST_DIR)
	rm -rf $(CMAKE_BUILD_DIR)
	rm -rf $(CMAKE_GTEST_DIR)
	rm -f $(NAME)
	rm -f $(NAME_CMAKE)

.PHONY: all test test-cmake clean check-gtest check-cmake

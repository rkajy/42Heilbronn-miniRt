# Ambient light (slightly gray)
A 0.2 255,255,255

# Camera at z = 10, looking toward origin (0,0,0)
# Position: 0, 0, 10
# Orientation: 0, 0, -1  (pointing along -Z)
# FOV: 60°
C 0,0,10  0,0,-1  60

# One white point light above and to the right
L 10,0,0  0.8  255,255,255

# Sphere at origin with radius 2
# Color: light blue
sp 0,0,0  2  150,180,255 T -2,0,0

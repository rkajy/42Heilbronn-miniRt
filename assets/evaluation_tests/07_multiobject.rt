A 0.2 255,255,255

# Camera looking at the whole scene from above-right
C 10,6,10  -1,-0.4,-1  60

# Light
L 5,10,5  0.8 255,255,255


# ---------------------------------------------------------
# 1. Two separated spheres
# ---------------------------------------------------------

# Sphere 1 (left)
sp -3,0,0  1.5  200,80,80

# Sphere 2 (right)
sp 3,0,0  1.5  80,80,200


# ---------------------------------------------------------
# 2. Two cylinders
# ---------------------------------------------------------

# Cylinder A (tilted +Z direction)
cy 0,0,0  0,0,1  1  8  80,200,80

# Cylinder B (tilted -Z direction)
cy 0,0,0  0,0,-1  1  8  200,200,80


# ---------------------------------------------------------
# 3. Plane at y = -2
# ---------------------------------------------------------

pl 0,-2,0  0,1,0  200,200,200


# ---------------------------------------------------------
# 4. Big sphere half above the plane
# ---------------------------------------------------------

# Plane is at y = -2
# Sphere radius = 3
# To make half visible: sphere center must be at y = -2 + 3 = 1
sp 0,1,0  3  150,150,255
